rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{roomCol}/{roomId} {
      allow read, write: if roomCol.matches('^(dev_)?rooms$');

      match /{allChildren=**} {
        allow read, write: if roomCol.matches('^(dev_)?rooms$');
      }
    }
  }
}
